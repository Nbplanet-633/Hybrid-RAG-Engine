# Copy to .env and fill in. Never commit .env.

# --- Answer generation -------------------------------------------------------
# Required only when generation.provider = "anthropic".
ANTHROPIC_API_KEY=sk-ant-...

# --- Reranking ---------------------------------------------------------------
# Required only when rerank.provider = "cohere".
COHERE_API_KEY=

# --- Profile override --------------------------------------------------------
# "full"    -> sentence-transformers embeddings + cross-encoder rerank + Claude
# "offline" -> hashing embeddings + lexical rerank + extractive generator
# Leave unset to use whatever config/app.yaml declares.
ASKMYDOCS_PROFILE=

# --- Path overrides (optional) ----------------------------------------------
ASKMYDOCS_STORAGE_DIR=./storage
ASKMYDOCS_CONFIG=./config/app.yaml
