    "/library/passages/{chunk_id}": {
      "get": {
        "description": "The full text of one passage, as cited by ``chunk_id`` in an answer.\n\nKeyed like /library/ask: chunk ids are predictable (``<doc_id>::0000``), so an\nopen endpoint would hand document text to anyone who knew a filename.",
        "operationId": "get_passage_library_passages__chunk_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "chunk_id",
            "required": true,
            "schema": {
