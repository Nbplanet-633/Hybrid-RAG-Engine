      "LibraryAskRequest": {
        "properties": {
          "doc_ids": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Answer only from these documents. Omit to search the whole library.",
            "title": "Doc Ids"
          },
          "include_retrieval": {
            "default": false,
            "description": "Include the full retrieval trace in the response.",
            "title": "Include Retrieval",
            "type": "boolean"
          },
          "question": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Question",
            "type": "string"
          },
          "top_n": {
            "anyOf": [
              {
                "maximum": 20.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Override how many reranked passages to use.",
            "title": "Top N"
          }
        },
        "required": [
          "question"
        ],
        "title": "LibraryAskRequest",
        "type": "object"
      },
      "LibraryInfo": {
        "properties": {
          "accepted_extensions": {
            "items": {
              "type": "string"
            },
            "title": "Accepted Extensions",
            "type": "array"
          },
          "answer_mode": {
            "description": "quote: answers are sentences quoted from the documents. generate: an LLM writes the answer from them.",
            "enum": [
              "quote",
              "generate"
            ],
            "title": "Answer Mode",
            "type": "string"
          },
          "documents": {
            "title": "Documents",
            "type": "integer"
          },
          "embedder": {
            "title": "Embedder",
            "type": "string"
          },
          "generator": {
            "title": "Generator",
            "type": "string"
          },
          "max_upload_bytes": {
            "title": "Max Upload Bytes",
            "type": "integer"
          },
          "profile": {
            "title": "Profile",
            "type": "string"
          },
          "requires_api_key": {
            "default": false,
            "description": "Whether library requests need an X-API-Key header.",
            "title": "Requires Api Key",
            "type": "boolean"
          },
          "reranker": {
            "title": "Reranker",
            "type": "string"
          },
          "samples_available": {
            "title": "Samples Available",
            "type": "boolean"
          }
