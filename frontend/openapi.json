        },
        "title": "IngestRequest",
        "type": "object"
      },
      "IngestResponse": {
        "properties": {
          "chunks": {
            "title": "Chunks",
            "type": "integer"
          },
          "documents": {
            "title": "Documents",
            "type": "integer"
          },
          "duration_s": {
            "title": "Duration S",
            "type": "number"
          },
          "skipped_unchanged": {
            "title": "Skipped Unchanged",
            "type": "integer"
          },
          "sources": {
            "items": {
