        "title": "PassageOut",
        "type": "object"
      },
      "RetrievedOut": {
        "properties": {
          "chunk_id": {
            "title": "Chunk Id",
            "type": "string"
          },
          "dense_rank": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dense Rank"
          },
          "lexical_rank": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lexical Rank"
          },
          "rank": {
            "title": "Rank",
            "type": "integer"
          },
          "retriever": {
            "enum": [
              "hybrid",
              "dense",
              "lexical"
            ],
            "title": "Retriever",
            "type": "string"
          },
          "score": {
            "title": "Score",
            "type": "number"
          },
          "section": {
            "default": "",
            "title": "Section",
            "type": "string"
          },
          "source": {
            "title": "Source",
