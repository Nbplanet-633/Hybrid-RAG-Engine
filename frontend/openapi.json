  "info": {
    "description": "Domain-specific RAG with hybrid retrieval, cross-encoder reranking, and enforced citations. Answers are returned only when the retrieved evidence supports them; otherwise the API abstains and says why.",
    "title": "Ask My Docs",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/ask": {
      "post": {
        "description": "Answer a question from the indexed documents, or abstain.",
        "operationId": "ask_ask_post",
        "parameters": [
          {
            "in": "header",
            "name": "x-api-key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AskResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Ask",
        "tags": [
          "query"
        ]
      }
    },
    "/healthz": {
      "get": {
        "description": "Liveness. Reports an initialisation failure rather than hiding it.",
