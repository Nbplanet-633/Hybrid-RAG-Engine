{
  "components": {
    "schemas": {
      "AskRequest": {
        "properties": {
          "include_retrieval": {
            "default": false,
            "description": "Include the full retrieval trace in the response.",
            "title": "Include Retrieval",
            "type": "boolean"
          },
          "question": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Question",
            "type": "string"
          },
          "top_n": {
            "anyOf": [
              {
                "maximum": 20.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Override how many reranked passages to use.",
            "title": "Top N"
          }
        },
        "required": [
          "question"
        ],
        "title": "AskRequest",
        "type": "object"
      },
      "AskResponse": {
        "properties": {
          "abstain_reason": {
            "default": "",
            "title": "Abstain Reason",
            "type": "string"
          },
          "abstained": {
            "title": "Abstained",
            "type": "boolean"
          },
          "answer": {
            "title": "Answer",
            "type": "string"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/CitationOut"
            },
            "title": "Citations",
            "type": "array"
          },
          "confidence": {
            "default": 0.0,
            "title": "Confidence",
            "type": "number"
          },
          "grounding_score": {
            "default": 0.0,
            "title": "Grounding Score",
            "type": "number"
          },
          "input_tokens": {
            "default": 0,
            "title": "Input Tokens",
            "type": "integer"
          },
          "latency_ms": {
            "default": 0.0,
            "description": "Generation only.",
            "title": "Latency Ms",
            "type": "number"
          },
          "model": {
            "default": "",
            "title": "Model",
            "type": "string"
          },
          "output_tokens": {
            "default": 0,
            "title": "Output Tokens",
            "type": "integer"
          },
          "prompt": {
            "default": "",
            "title": "Prompt",
            "type": "string"
          },
          "question": {
            "title": "Question",
            "type": "string"
          },
          "retrieval": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/RetrievedOut"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Retrieval"
          },
          "total_ms": {
            "default": 0.0,
            "description": "The whole question, retrieval included.",
            "title": "Total Ms",
            "type": "number"
          }
        },
        "required": [
          "question",
          "answer",
          "abstained",
          "abstain_reason",
          "citations",
          "confidence",
          "grounding_score",
          "model",
          "prompt",
          "latency_ms",
          "total_ms",
          "input_tokens",
          "output_tokens",
          "retrieval"
        ],
        "title": "AskResponse",
        "type": "object"
      },
      "Body_upload_document_library_documents_post": {
        "properties": {
          "file": {
            "contentMediaType": "application/octet-stream",
            "description": "A PDF, Markdown, text, or HTML file.",
            "title": "File",
            "type": "string"
          }
        },
        "required": [
          "file"
        ],
        "title": "Body_upload_document_library_documents_post",
        "type": "object"
      },
      "CitationOut": {
        "properties": {
          "chunk_id": {
            "default": "",
            "title": "Chunk Id",
            "type": "string"
          },
          "marker": {
            "title": "Marker",
            "type": "string"
          },
          "quote": {
            "default": "",
            "title": "Quote",
            "type": "string"
          },
          "score": {
            "default": 0.0,
            "title": "Score",
            "type": "number"
          },
          "section": {
            "default": "",
            "title": "Section",
            "type": "string"
          },
          "source": {
            "title": "Source",
            "type": "string"
          },
          "title": {
            "default": "",
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "marker",
          "source",
          "section",
          "title",
          "quote",
          "score",
          "chunk_id"
        ],
        "title": "CitationOut",
        "type": "object"
      },
      "DocumentSummary": {
        "description": "One document in the upload library, as listed to a user.",
