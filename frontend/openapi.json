          "source",
          "section",
          "chunk_id",
          "score",
          "retriever",
          "dense_rank",
          "lexical_rank"
        ],
        "title": "RetrievedOut",
        "type": "object"
      },
      "SamplesResponse": {
        "properties": {
          "added": {
            "items": {
              "$ref": "#/components/schemas/DocumentSummary"
