          "filename",
          "title",
          "content_type",
          "chunks",
          "size_bytes"
        ],
        "title": "DocumentSummary",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "IngestRequest": {
        "properties": {
          "reset": {
            "default": false,
